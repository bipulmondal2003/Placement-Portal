# ---------- Shared ----------
NODE_ENV=development

# ---------- API (apps/api) ----------
PORT=4000
# Mongo connection string. For docker-compose use: mongodb://mongo:27017/placement_readiness
MONGODB_URI=mongodb://localhost:27017/placement_readiness

# Auth: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Recruiter sessions use a shorter, stricter policy
RECRUITER_JWT_EXPIRES_IN=30m

# Browser origin(s) allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# Redis: a single URL-based connection strategy is used everywhere (API, worker, cache, queues)
# For docker-compose use: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT:YOUR_PORT
# Gemini (optional - core eligibility/readiness work without it)
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verify the model name against current Google docs; model availability varies by account.
GEMINI_MODEL=gemini-3.8-flash

# Queue tuning
BATCH_CONCURRENCY=4
RECALC_DEBOUNCE_MS=3000
# Run the BullMQ worker inside the API process. Defaults to true in development and false in production (docker-compose runs a separate worker service).
EMBED_WORKER=true
# Seconds-long provider calls are cut off after this many milliseconds.
AI_TIMEOUT_MS=30000

# Rate limits (requests per minute, per client). Defaults are conservative; raise only for load tests.
THROTTLE_LIMIT=120
RECRUITER_THROTTLE_LIMIT=20
LOGIN_THROTTLE_LIMIT=10
RECRUITER_LOGIN_THROTTLE_LIMIT=5
AI_THROTTLE_LIMIT=10

# Seeding demo data is refused when NODE_ENV=production unless this is "true".
ALLOW_SEED_IN_PRODUCTION=false

# ---------- Web (apps/web) ----------
# The browser only talks to the web origin; Next.js proxies /api/* to this address (server-side only).
# In docker-compose this is passed as a build argument (http://api:4000) because Next bakes rewrites in at build time.
API_INTERNAL_URL=http://localhost:4000
